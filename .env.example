# ─────────────────────────────────────────────────────────────────────────────
# Smart Property Verification Platform — Supabase Configuration (Phase 13)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill with your Supabase project credentials.
# NEVER commit the real .env.local file — it is git-ignored.

# Public Project URL (safe to expose — only identifies the project, no secrets).
NEXT_PUBLIC_SUPABASE_URL=https://xoauymrzubxkfnnykezy.supabase.co

# Public Anon (anonymous) API key — safe to use in the browser for read-only
# operations that respect Row Level Security. Never use this for privileged ops.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role key — SERVER ONLY. Must NEVER be exposed to the browser.
# Used by server-side API routes to perform privileged database operations
# (e.g. writing audit logs, seeding data, bypassing RLS for admin tasks).
# Store this in .env.local and NEVER in any client-side bundle.
SUPABASE_SERVICE_ROLE_KEY=


